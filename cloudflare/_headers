# Cloudflare Pages 响应头：确保 ESM 模块以正确 MIME 返回
/src/*.mjs
  Content-Type: text/javascript; charset=utf-8
  X-Content-Type-Options: nosniff

/cf-runtime.mjs
  Content-Type: text/javascript; charset=utf-8
  X-Content-Type-Options: nosniff

/index.html
  Cache-Control: no-store
  X-Content-Type-Options: nosniff

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
